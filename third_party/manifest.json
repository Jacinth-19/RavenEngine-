{
  "$schema": "https://cyclonedx.org/schema/spdx.schema.json",
  "schemaVersion": 1,
  "comment": "Pinned vendored dependencies for RavenEngine. Versions are recorded from the vendored sources at the time of vendoring; verify before bumping. Regenerate SBOM with scripts/generate_sbom.py.",
  "dependencies": [
    { "name": "Vulkan-Headers", "version": "290", "license": "Apache-2.0", "source": "https://github.com/KhronosGroup/Vulkan-Headers", "purpose": "Vulkan 1.3 C/C++ headers", "type": "library" },
    { "name": "glfw", "version": "3.4", "license": "Zlib", "source": "https://github.com/glfw/glfw", "purpose": "windowing + input (editor/sandbox)", "type": "library" },
    { "name": "glm", "version": "1.0.1", "license": "MIT", "source": "https://github.com/g-truc/glm", "purpose": "linear algebra", "type": "library" },
    { "name": "imgui", "version": "1.93.1-docking", "license": "MIT", "source": "https://github.com/ocornut/imgui", "purpose": "editor UI (docking branch)", "type": "library" },
    { "name": "imguizmo", "version": "vendored-snapshot", "license": "MIT", "source": "https://github.com/CedricGuillemet/ImGuizmo", "purpose": "editor transform gizmos", "type": "library" },
    { "name": "nlohmann-json", "version": "3.11.3", "license": "MIT", "source": "https://github.com/nlohmann/json", "purpose": "JSON parsing (scenes, assets, project files)", "type": "library" },
    { "name": "lua", "version": "5.4.9", "license": "MIT", "source": "https://www.lua.org/", "purpose": "embedded scripting", "type": "library" },
    { "name": "miniaudio", "version": "0.11.26", "license": "Unlicense/MIT-0", "source": "https://github.com/mackron/miniaudio", "purpose": "audio engine (device, 3D spatialization)", "type": "library" },
    { "name": "stb", "version": "stb_image/stb_image_write (public domain/MIT)", "license": "MIT/PD", "source": "https://github.com/nothings/stb", "purpose": "image load + PNG write", "type": "library" },
    { "name": "tinyobjloader", "version": "2.0.0", "license": "MIT", "source": "https://github.com/tinyobjloader/tinyobjloader", "purpose": "OBJ mesh import", "type": "library" }
  ]
}
